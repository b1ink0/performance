+/**
+ * Resolves the Docker base image for a service.
+ *
+ * @param {string}   service The service name.
+ * @param {string}   env     The environment name.
+ * @param {WPConfig} config  The configuration object.
+ * @return {string} The Docker image reference.
+ */
+function getBaseImage( service, env, config ) {
+	const customImage = config.env[ env ].dockerImages?.[ service ];
+
+	if ( customImage ) {
+		return customImage;
+	}
+
+	const phpVersion = config.env[ env ].phpVersion
+		? service === 'wordpress'
+			? ':php' + config.env[ env ].phpVersion
+			: '-php' + config.env[ env ].phpVersion
+		: '';
+
+	return service === 'wordpress'
+		? `wordpress${ phpVersion }`
+		: `wordpress:cli${ phpVersion }`;
+}
